---
import DocsLayout from '../layouts/DocsLayout.astro';
import VernacularPanels from '../components/VernacularPanels.astro';
import FeatureCards from '../components/FeatureCards.astro';
import Carousel from '../components/Carousel.astro';
import LevelPicker from '../components/LevelPicker.astro';
import Playground from '../components/Playground.astro';
import ReviewStamp from '../components/ReviewStamp.astro';
import Glossary from '../components/Glossary.astro';
import { siteConfig } from '../../site.config.ts';
// Read from the app itself, so the version shown cannot go stale.
import pkg from '../../../package.json';

import { Content as Dev, frontmatter as devFm } from '../docs/dev.md';
import { Content as Plain, frontmatter as plainFm } from '../docs/plain.md';
import { Content as Eli5, frontmatter as eli5Fm } from '../docs/eli5.md';

// One source: GUIDE.md / INSTALL.md copied in by scripts/sync-docs.mjs.
const sources = import.meta.glob<{ Content: any }>('../docs/source/*.md', { eager: true });
const guide = sources['../docs/source/guide.md'];
const install = sources['../docs/source/install.md'];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const shot = (file: string) => `${base}/screenshots/${file}`;

const features = [
  { icon: '🔒', title: 'Yours, on your machine', text: 'Entries are plain markdown files in a folder you own. No account, no company, no server but yours.' },
  { icon: '🎙️', title: 'Speak Greek or English', text: 'Record and it transcribes, word for word or tidied. The original stays beside the English.' },
  { icon: '🧭', title: 'Put in order', text: 'Each entry carries when it happened, not when you typed it. A rough range is enough.' },
  { icon: '🏷️', title: 'Names what happened', text: 'Gaslighting, DARVO, scapegoat, fawn, gray rock and more, each with a plain definition and your own words as proof.' },
  { icon: '📖', title: 'Chapters you can check', text: 'Entries grouped into episodes and drafted into chapters. The draft is asked to cite an entry after every claim, and made-up citations are removed.' },
  { icon: '🔌', title: 'Any AI, or none', text: 'Free cloud tiers, your own keys, or models on your own hardware. Local-only is enforced, not preferred.' },
];

const slides = [
  { title: 'Record', caption: 'Press Record, or just write. Saved to your own disk as you go.', image: shot('01-record.png'), alt: 'My Story recording an entry, with the entry list and the English translation beside it.' },
  { title: 'Greek, with English beside it', caption: 'The original is never overwritten. The translation sits next to it.', image: shot('02-entry.png'), alt: 'A Greek entry with its English translation beside it.' },
  { title: 'Indicators', caption: 'A named pattern, what it means, and the words of yours it was found in.', image: shot('03-indicators.png'), alt: 'Indicators: a named pattern, its definition, and the quote it was found in.' },
  { title: 'Episodes', caption: 'Entries grouped by when they happened, drafted into a chapter with citations.', image: shot('04-episodes.png'), alt: 'Episodes: entries grouped by time and drafted into a chapter with citations.' },
  { title: 'Where your words go', caption: 'Nothing goes to a cloud provider until you tick this box.', image: shot('05-consent.png'), alt: 'Settings: the Where your words go box with the consent tick ticked, above the Models panel.' },
  { title: 'Which model does which job', caption: 'A first choice and two fallbacks for every job. The app says which one answered.', image: shot('06-models.png'), alt: 'Which model does which job: a first choice and two fallbacks per job.' },
  { title: 'On your phone', caption: 'Over your own Tailscale network. Installs to the home screen.', image: shot('07-phone.png'), alt: 'The Vault screen on a phone: the entry box and the Record button.' },
];
---
<DocsLayout title="Overview" home>
  <section class="frame hero reveal" id="top">
    <span class="label">Docs · v{pkg.version}</span>
    <h1 class="hero-title">{siteConfig.projectName}</h1>
    <p class="hero-sub">{siteConfig.description}</p>
    <div class="btns">
      {siteConfig.heroLinks.map((l) => (
        <a class:list={['btn', { primary: l.primary }]} href={l.href}>{l.label}</a>
      ))}
    </div>
    <div class="pills">
      {siteConfig.heroPills.map((t) => (
        <span class="pill"><i></i>{t}</span>
      ))}
    </div>
  </section>

  <LevelPicker />

  <FeatureCards features={features} title="What it does" />
  <Carousel slides={slides} label="Screenshots" />

  <section class="doc-body reveal" id="docs" aria-label="Documentation" data-glossary>
    <VernacularPanels>
      <Fragment slot="dev"><ReviewStamp {...devFm} /><Dev /></Fragment>
      <Fragment slot="plain"><ReviewStamp {...plainFm} /><Plain /></Fragment>
      <Fragment slot="eli5"><ReviewStamp {...eli5Fm} /><Eli5 /></Fragment>
    </VernacularPanels>
  </section>

  {/* No "reveal" on Install and Guide: it waits for part of a section to be on screen, which a long section never reaches. */}
  {install && (
    <section class="doc-body doc-source" id="install" aria-label="Install" data-glossary>
      <install.Content />
    </section>
  )}
  {guide && (
    <section class="doc-body doc-source" id="guide" aria-label="Guide" data-glossary>
      <guide.Content />
    </section>
  )}

  {siteConfig.playground.enabled && <Playground />}
  <Glossary />
</DocsLayout>
