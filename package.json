{
  "name": "mystory",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.cjs public",
    "gemini:doctor": "node scripts/gemini-doctor.mjs",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-shortcut.ps1",
    "prepare": "git config core.hooksPath githooks || true",
    "desktop": "npm run build && electron .",
    "desktop:browser": "npm run build && electron . --browser",
    "build-exe": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "googleapis": "^173.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.2"
  },
  "description": "A private, self-hosted journal for recording your own life. Speech to text, plain markdown files on your own machine, local or cloud AI, Greek and English.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Stravelakis/mystory.git"
  },
  "keywords": [
    "journal",
    "diary",
    "self-hosted",
    "local-first",
    "privacy",
    "cptsd",
    "trauma-informed",
    "speech-to-text",
    "whisper",
    "ollama",
    "localai",
    "greek",
    "markdown",
    "offline"
  ],
  "author": "stravelakis",
  "main": "electron/main.cjs",
  "build": {
    "appId": "net.stravelakis.mystory",
    "productName": "My Story",
    "files": [
      "dist/**",
      "electron/**",
      "public/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/mystory.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "My Story",
      "uninstallDisplayName": "My Story",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "my-story-portable-${version}.exe"
    }
  }
}
