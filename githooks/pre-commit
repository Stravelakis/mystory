#!/bin/sh
# =============================================================================
# PRE-COMMIT — blocks secrets and private network addresses.
#
# Turn on once per clone:  git config core.hooksPath githooks
#                          (npm install does this for you — see "prepare")
# On macOS/Linux also:     chmod +x githooks/pre-commit
#
# Two checks, in this order:
#
#   1. gitleaks — the standard secret scan (repo standards §4). If gitleaks is
#      not installed the commit is refused rather than waved through, because
#      a scan that silently did not run is worse than no scan.
#
#   2. Private addresses — gitleaks looks for secrets, not for addresses. A
#      Tailscale or LAN address is not a secret, but it names a machine the
#      owner runs and does not belong in a public repo (standards §3).
#
# To get past it deliberately — a placeholder that looks real — use
#   git commit --no-verify
# and know exactly why.
# =============================================================================

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks isn't installed, so this commit can't be checked for secrets." >&2
  echo "Install it (https://github.com/gitleaks/gitleaks#installing), then commit again." >&2
  exit 1
fi

gitleaks git --pre-commit --redact --staged --verbose || exit 1

addr=$(git diff --cached -U0 | grep -E '^\+' | grep -v '^+++' \
  | grep -oE '100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}|192\.168\.[0-9]{1,3}\.[0-9]{1,3}|[a-z0-9-]+\.ts\.net' \
  | grep -vE '^(tailnet-name|your-tailnet|example|<)' \
  | grep -vE '(tailnet-name|your-tailnet|example)\.ts\.net$' \
  | head -1)

if [ -n "$addr" ]; then
  echo "" >&2
  echo "  COMMIT BLOCKED — a private network address is being added: $addr" >&2
  echo "  It names a machine you run. Use a placeholder such as" >&2
  echo "  https://<machine>.<tailnet>.ts.net instead." >&2
  echo "" >&2
  exit 1
fi

exit 0
