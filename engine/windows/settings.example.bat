@rem Copy to engine\settings.bat to change anything. Optional.
@rem The SSH name of the mini PC (as in "ssh minipc"), used to fetch your reading clips.
set MINIPC=minipc
@rem Where the vault lives on the mini PC.
set MINIPC_VAULT=~/.local/share/mystory/vault
@rem Where My Story's code lives on the mini PC.
set MINIPC_REPO=~/apps/mystory
@rem Port the engine listens on.
set STT_PORT=40666
