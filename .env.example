# =============================================================================
# My Story — configuration.
#
# You do not have to edit this file. Everything here can be set from the
# Settings screen in the app, which writes the real .env beside it. Copy this
# to .env only if you would rather configure the box before you open it.
#
# Nothing here is required to start. With no keys and no local endpoint the
# app still records, still writes entries to disk, and still keeps your audio —
# it simply cannot transcribe or draft until you point it at a model.
# =============================================================================

# --- Where models run --------------------------------------------------------
# cloud-first  the cloud is asked first, a local runtime is the fallback
# local-first  your own machine first, cloud only when it cannot answer
# local-only   nothing leaves this machine. Cloud providers are never asked,
#              and Google Drive is refused while this is set.
MODEL_ROUTING="cloud-first"

# Consent to send entries to cloud providers. Until this is "yes", only models
# on this machine are asked, and DeepL is not used either. Settings → Where
# your words go → "I understand where my words go".
CLOUD_CONSENT=""

# Any OpenAI-compatible endpoint. Ollama, LM Studio, llama.cpp's server, vLLM
# and LocalAI all speak it. Include /v1 or leave it off — either is accepted.
#   LocalAI    http://localhost:8080/v1   (also serves transcription)
#   Ollama     http://localhost:11434/v1
#   LM Studio  http://localhost:1234/v1
#   llama.cpp  http://localhost:8080/v1
LOCAL_CHAT_BASE_URL=""
LOCAL_CHAT_MODEL=""
# Most local runtimes ignore this. vLLM behind a proxy may not.
LOCAL_CHAT_API_KEY=""
# What to call it in the interface. Defaults to "Local".
LOCAL_CHAT_LABEL=""

# Local transcription. Speaches, faster-whisper-server and whisper.cpp's server
# all expose an OpenAI-compatible /v1/audio/transcriptions.
LOCAL_STT_BASE_URL=""
LOCAL_STT_MODEL="Systran/faster-whisper-large-v3"
LOCAL_STT_API_KEY=""

# --- Aggregators, and anything else OpenAI-compatible -----------------------
# OpenRouter fronts hundreds of models behind one key. Opt-in only: it is never
# used for a job unless you assign it to one in Settings.
OPENROUTER_API_KEY=""

# Anything else speaking the OpenAI shape — a gateway, a company proxy, a
# service that appeared after this shipped. No code change, only a URL.
CUSTOM_BASE_URL=""
CUSTOM_API_KEY=""
CUSTOM_LABEL=""

# OmniRoute, or any gateway like it: one OpenAI-compatible URL that fronts many
# providers and rotates their keys. Give the address with /v1.
OMNIROUTE_BASE_URL=""
OMNIROUTE_API_KEY=""

# --- Which model does which job ---------------------------------------------
# Six jobs, each with a first choice and two fallbacks. The format is
# "<providerId>::<model>", for example "gemini::gemini-2.5-flash".
# Leave a job blank and the app picks for itself from whatever is configured.
#
# DO NOT TYPE MODEL NAMES FROM MEMORY. Providers rename and retire them
# constantly, and a stale name is a 404. Press "Load models" in Settings, or
# run "npm run gemini:doctor", and use a name that came back.
#
#   MODEL_TRANSCRIBE_1  MODEL_TRANSCRIBE_2  MODEL_TRANSCRIBE_3
#   MODEL_WHEN_1        MODEL_WHEN_2        MODEL_WHEN_3
#   MODEL_INDICATORS_1  MODEL_INDICATORS_2  MODEL_INDICATORS_3
#   MODEL_COMPANION_1   MODEL_COMPANION_2   MODEL_COMPANION_3
#   MODEL_TITLE_1       MODEL_TITLE_2       MODEL_TITLE_3
#   MODEL_SYNTHESIS_1   MODEL_SYNTHESIS_2   MODEL_SYNTHESIS_3

# --- Cloud providers ---------------------------------------------------------
# None are required, and none are hardcoded into a feature. Each job walks a
# chain and uses the first provider you have a key for.
GEMINI_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""
NVIDIA_API_KEY=""
CEREBRAS_API_KEY=""

# --- Translation --------------------------------------------------------------
# DeepL renders a translation rather than rewriting it. A free key ends in
# ":fx". Without one, a language model translates.
DEEPL_API_KEY=""
# Speech-to-speech translation through a Gemini Live model. Off unless set; the
# preview model tried so far dropped the last sentence.
LIVE_TRANSLATE_MODEL=""

# --- Google Drive (optional) -------------------------------------------------
# Archiving mirrors an entry into your own Drive. The vault works completely
# without it, and it is switched off entirely under local-only routing.
# Create an OAuth client (type: Web application) and add a redirect URI ending
# in /auth/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Overrides the callback URL sent to Google. Only needed when the origin you
# browse to differs from the one Google must redirect to.
# GOOGLE_REDIRECT_URI=""

# --- Where things live -------------------------------------------------------
# VAULT_DIR         defaults to ./vault
# VAULT_KEEP_AUDIO  "off" to stop retaining the original recordings
# INDICATORS_FILE   a JSON file of your own terms, replacing the built-in
#                   vocabulary entirely. See vocabulary.ts for the shape.
# PORT              defaults to 38726
# HOST              interface to bind. Defaults to every interface, IPv4 and
#                   IPv6. Set 127.0.0.1 to keep it on this machine (and
#                   publish with "tailscale serve"), or your Tailscale address
#                   to publish on the tailnet and nowhere else.
# PROVIDER_TIMEOUT_MS  defaults to 120000. Raise it for a slow local model.
# LIVE_TIMEOUT_MS   one Gemini Live session, default 180000.
# MYSTORY_ENV_PATH  where this file lives. The desktop app sets it to
#                   %APPDATA%\mystory\.env so an update never touches it.
# NODE_ENV          "production" serves the built client from dist/.
# DISABLE_HMR       "true" turns off hot reload in development.

# --- Written by the app, not by you ------------------------------------------
# APP_PASSCODE_HASH     scrypt hash of the vault passcode, set under Settings.
#                       Delete this line and restart to unlock a vault whose
#                       passcode was lost. Your entries are not encrypted with
#                       it, so nothing is lost by doing so.
# SESSION_SECRET        signs session cookies. Generated on first boot.
#                       Deleting it simply signs you out everywhere.
# GOOGLE_REFRESH_TOKEN
# GOOGLE_ACCOUNT_EMAIL  written when you link a Google account. Use "Unlink" in
#                       Settings rather than editing these by hand — the app
#                       also revokes the grant at Google.
